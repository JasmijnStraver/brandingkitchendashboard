# Kopieer naar .env.local en vul in met je eigen Supabase-project (regio Frankfurt).
# Project-instellingen > API in je Supabase-dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Niet nodig in Next.js zelf (de Edge Functions gebruiken hun eigen secrets via
# `supabase secrets set`), maar handig om hier te laten staan als geheugensteun:
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# PORTAAL_URL=http://localhost:3000
